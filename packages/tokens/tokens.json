{
  "name": "Atlas Design Tokens",
  "version": "1.0.0",
  "palette": {
    "background": {
      "base": "#0a0b0e",
      "subtle": "#101217",
      "surface": "#161922",
      "elevated": "#1e2230",
      "overlay": "rgba(10, 11, 14, 0.85)"
    },
    "border": {
      "subtle": "#1f2430",
      "default": "#2d3345",
      "focus": "#f97316"
    },
    "brand": {
      "primary": "#ea580c",
      "primaryHover": "#f97316",
      "primaryLight": "#fb923c",
      "gold": "#d4af37",
      "parchment": "#f4efe6",
      "ink": "#111215"
    },
    "text": {
      "primary": "#f8fafc",
      "secondary": "#94a3b8",
      "muted": "#64748b",
      "inverse": "#090d16"
    },
    "status": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444",
      "info": "#3b82f6",
      "suspended": "#8b5cf6"
    },
    "license": {
      "publicDomain": "#10b981",
      "creativeCommons": "#3b82f6",
      "aiGenerated": "#f59e0b",
      "restricted": "#ef4444"
    }
  },
  "typography": {
    "fonts": {
      "display": "'Playfair Display', Georgia, serif",
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "video": {
      "vertical": {
        "width": 1080,
        "height": 1920,
        "fontSizeDisplay": 64,
        "fontSizeTitle": 48,
        "fontSizeBody": 36,
        "fontSizeAttribution": 20,
        "maxCharsPerLine": 28,
        "safeMargins": {
          "top": 240,
          "bottom": 320,
          "left": 80,
          "right": 80
        }
      },
      "horizontal": {
        "width": 1920,
        "height": 1080,
        "fontSizeDisplay": 54,
        "fontSizeTitle": 42,
        "fontSizeBody": 30,
        "fontSizeAttribution": 18,
        "maxCharsPerLine": 45,
        "safeMargins": {
          "top": 120,
          "bottom": 120,
          "left": 160,
          "right": 160
        }
      }
    }
  },
  "pacing": {
    "targetDurationSeconds": 60,
    "fps": 30,
    "totalFrames": 1800,
    "wordBudget": {
      "min": 110,
      "max": 150
    },
    "beatsBudget": {
      "min": 12,
      "max": 18
    },
    "secondsPerBeat": {
      "min": 3.0,
      "max": 4.5
    },
    "wordsPerBeat": {
      "min": 6,
      "max": 12
    },
    "linesPerBeat": {
      "min": 1,
      "max": 2
    },
    "distinctImages": {
      "min": 6,
      "max": 12
    }
  },
  "audio": {
    "targetLoudnessLufs": -14,
    "loudnessTolerance": 1,
    "keystrokeVariationMs": 35
  }
}
